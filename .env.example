# Copy this file to .env before running docker compose.

API_KEY=change-me
OPENCODE_SERVER_PASSWORD=change-me-too

# Safer default. Keep true unless you really want model tool access.
OPENCODE_DISABLE_TOOLS=true

# External tool bridge is implemented by the proxy, not by OpenCode internal tools.
# Supported values today:
# - OPENCODE_EXTERNAL_TOOLS_MODE=proxy-bridge
# - OPENCODE_EXTERNAL_TOOLS_CONFLICT_POLICY=namespace
OPENCODE_EXTERNAL_TOOLS_MODE=proxy-bridge
OPENCODE_EXTERNAL_TOOLS_CONFLICT_POLICY=namespace

# Helpful when running behind OpenClaw or other clients that already manage prompts.
OPENCODE_PROXY_PROMPT_MODE=plugin-inject
OPENCODE_PROXY_OMIT_SYSTEM_PROMPT=true

# Periodically clean proxy-owned conversation/session storage.
OPENCODE_PROXY_AUTO_CLEANUP_CONVERSATIONS=true
OPENCODE_PROXY_CLEANUP_INTERVAL_MS=43200000
OPENCODE_PROXY_CLEANUP_MAX_AGE_MS=86400000

# Conversation session reuse: a client that sends a session identity header
# (session-id, x-deepseek-harness-session-id, x-opencode-session, ...) keeps one
# backend session across the turns of that conversation, so the upstream
# (OpenCode Zen/Go) sees a stable x-opencode-session instead of a new one per
# request. Clients without such a header stay stateless.
OPENCODE_PROXY_SESSION_REUSE=true
# OPENCODE_PROXY_SESSION_TTL_MS=1800000
# OPENCODE_PROXY_SESSION_HEADERS=session-id,x-deepseek-harness-session-id

# Gateways that cannot forward a session header can still get session affinity:
# with this on, the conversation is recognised from the request itself (client
# scope + first message + transcript prefix), and look-alike conversations that
# content cannot tell apart are never merged.
# OPENCODE_PROXY_SESSION_DERIVE=false

# Direct upstream: with a key, Go-subscription and paid-Zen models are sent
# straight to OpenCode's OpenAI-compatible endpoints (the local runtime is then
# only used for the free tier, whose gate cannot be satisfied by plain HTTP).
# OPENCODE_PROXY_DIRECT=true
# OPENCODE_PROXY_DIRECT_GO_URL=https://opencode.ai/zen/go/v1
# OPENCODE_PROXY_DIRECT_ZEN_URL=https://opencode.ai/zen/v1
# OPENCODE_PROXY_DIRECT_FREE_VIA_RUNTIME=true
# OPENCODE_PROXY_DIRECT_FALLBACK=true

# Optional overrides
# OPENCODE_PROXY_PORT=10000
# OPENCODE_SERVER_PORT=10001
# OPENCODE_USE_ISOLATED_HOME=false
# OPENCODE_PROXY_REQUEST_TIMEOUT_MS=180000
# OPENCODE_PROXY_DEBUG=false
# OPENCODE_ZEN_API_KEY=
