# opencode-gateway environment template.
#
#   cp .env.example .env
#   $EDITOR .env            # at minimum set API_KEY and OPENCODE_SERVER_PASSWORD
#   docker compose up -d
#
# Every variable the gateway understands is listed below with the value the
# documentation calls the default (docs/zh/configuration.md); the same names are
# accepted by `docker run -e` and by a native `node index.js` start. Precedence
# in every case is: process environment > config.json > built-in default, so a
# value you remove here falls back to config.json when you use one.
#
# Only two variables usually need editing:

# Bearer key that /v1/* clients must send. With the default public bind
# (0.0.0.0), startup refuses an empty key unless you explicitly opt in below.
API_KEY=
# Dangerous escape hatch for a deliberately unauthenticated non-loopback
# listener. Keep false for normal deployments.
OPENCODE_PROXY_ALLOW_PUBLIC_NO_AUTH=false
# Password for the gateway's own OpenCode backend. Empty means "no password".
OPENCODE_SERVER_PASSWORD=

# ------------------------------------------------------------------ service --
OPENCODE_PROXY_PORT=10000
# `PORT` is accepted as an alias for the line above.
# PORT=10000
BIND_HOST=0.0.0.0
OPENCODE_SERVER_PORT=10001
OPENCODE_SERVER_URL=http://127.0.0.1:10001
OPENCODE_PROXY_MANAGE_BACKEND=true
OPENCODE_PATH=opencode
OPENCODE_USE_ISOLATED_HOME=false
# Zen API key: with it, Go-subscription and paid-Zen models go straight to the
# upstream and only the free tier uses the local runtime.
OPENCODE_ZEN_API_KEY=

# -------------------------------------------------------------- tool policy --
OPENCODE_DISABLE_TOOLS=true
OPENCODE_EXTERNAL_TOOLS_MODE=proxy-bridge
# Built-in tools allowed when a request carries no `tools` (comma separated).
OPENCODE_INTERNAL_ALLOWED_TOOLS=
# Allow web_fetch when no allowlist is configured.
OPENCODE_INTERNAL_WEB_FETCH_ENABLED=false

# ---------------------------------------------------------- prompts/sessions --
OPENCODE_PROXY_PROMPT_MODE=standard
OPENCODE_PROXY_OMIT_SYSTEM_PROMPT=false
# Sweep stored conversations on a schedule: off | hourly | daily.
OPENCODE_PROXY_STORAGE_CLEANUP=off
OPENCODE_PROXY_REQUEST_TIMEOUT_MS=180000
# Process-wide backpressure: active turns + bounded FIFO waiters.
OPENCODE_PROXY_MAX_CONCURRENT_TURNS=20
OPENCODE_PROXY_MAX_PENDING_TURNS=100
# Maximum queue wait before 503 gateway_overloaded; 0 means fail fast.
OPENCODE_PROXY_CONCURRENCY_WAIT_MS=2000
# One upstream session per conversation identity, so prompt caches keep working.
OPENCODE_PROXY_SESSION_REUSE=true
OPENCODE_PROXY_SESSION_TTL_MS=1800000
# Session identity headers, first non-empty wins.
OPENCODE_PROXY_SESSION_HEADERS=x-opencode-session,x-session-id,x-thread-id,x-conversation-id,x-deepseek-harness-session-id,session-id,session_id,thread-id,thread_id,conversation-id,conversation_id
# Recognise the conversation from the request itself when no header arrives.
OPENCODE_PROXY_SESSION_DERIVE=false

# Operational endpoints: off (only /health) | health (adds /health/details) | full (adds /metrics).
# Both detail endpoints always require the bearer key.
OPENCODE_PROXY_OPS=health

# ------------------------------------------------------------ direct upstream --
OPENCODE_PROXY_DIRECT=true
OPENCODE_PROXY_DIRECT_GO_URL=https://opencode.ai/zen/go/v1
OPENCODE_PROXY_DIRECT_ZEN_URL=https://opencode.ai/zen/v1
OPENCODE_PROXY_DIRECT_FALLBACK=true
# Outbound proxy for upstream calls (socks5h://, socks5://, socks4a://, socks4://, http://, https://).
# The standard variables below are read as lower-precedence fallbacks, and NO_PROXY is
# honoured; the lowercase spellings (all_proxy, https_proxy, http_proxy, no_proxy) work
# too. Loopback traffic (the managed runtime, health checks) is never proxied. They stay
# commented out so sourcing this file cannot clobber a proxy already set in your shell.
OPENCODE_PROXY_UPSTREAM_PROXY=
# ALL_PROXY=
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=
# Also give the proxy to the managed runtime, so the free tier's egress uses it too.
OPENCODE_PROXY_UPSTREAM_PROXY_FOR_RUNTIME=true

# ------------------------------------------------- diagnostics / operational --
OPENCODE_PROXY_DEBUG=false
OPENCODE_GATEWAY_EVENT_IDLE_TIMEOUT_MS=8000
OPENCODE_GATEWAY_EVENT_FIRST_DELTA_TIMEOUT_MS=30000

# ---------------------------------------------------- container only (docker) --
# Owner of the mounted OpenCode volumes; set these to your NAS user.
PUID=1000
PGID=1000
