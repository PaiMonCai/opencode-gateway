{
    "root": true,
    "comment": "Legacy eslintrc kept in sync with eslint.config.js for editors that still read it. ESLint 9+ uses the flat config; this file is ignored by the CLI. MIGRATION: the ignorePatterns below are the pre-rewrite files architecture §5 step 4 deletes; T4 must empty them.",
    "env": {
        "node": true,
        "es2023": true,
        "jest": true
    },
    "parserOptions": {
        "ecmaVersion": 2023,
        "sourceType": "module"
    },
    "extends": ["eslint:recommended"],
    "ignorePatterns": [
        "node_modules/",
        "coverage/",
        "index.js",
        "src/proxy.js",
        "src/tool-runtime/",
        "src/upstream/",
        "tests/unit/*.test.js",
        "tests/integration/",
        "tests/manual/"
    ],
    "rules": {
        "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
        "no-console": "off",
        "eqeqeq": ["error", "smart"],
        "prefer-const": "error",
        "no-var": "error",
        "object-shorthand": ["error", "properties"]
    }
}
