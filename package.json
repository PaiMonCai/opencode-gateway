{
    "name": "opencode-gateway",
    "version": "3.0.0",
    "description": "OpenAI-compatible middleware that lets any OpenAI gateway (NewAPI, LiteLLM, ...) talk to OpenCode.",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "node index.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --runInBand --detectOpenHandles",
        "test:contract": "NODE_OPTIONS=--experimental-vm-modules jest tests/contract --runInBand --passWithNoTests",
        "test:verify": "NODE_OPTIONS=--experimental-vm-modules jest tests/verification --runInBand",
        "test:one": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:all": "npm run test && npm run test:contract && npm run test:verify",
        "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --coverage --runInBand --detectOpenHandles",
        "test:integration": "bash tests/integration/test-integration.sh",
        "test:e2e": "bash tests/e2e/smoke.sh",
        "test:stream": "bash tests/manual/test-streaming-real.sh"
    },
    "keywords": [
        "opencode",
        "openai",
        "proxy",
        "kimi",
        "glm",
        "minimax",
        "ai",
        "api"
    ],
    "author": "",
    "license": "MIT",
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "@opencode-ai/sdk": "^1.18.34",
        "body-parser": "^1.20.3",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "https-proxy-agent": "^7.0.6",
        "socks-proxy-agent": "^8.0.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/node": "^24.19.1",
        "eslint": "^10.12.0",
        "globals": "^16.5.0",
        "jest": "^30.2.0",
        "prettier": "^3.9.9",
        "supertest": "^7.2.2",
        "typescript": "^5.9.3"
    }
}
